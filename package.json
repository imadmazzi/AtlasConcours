{
  "name": "atlasconcours",
  "version": "1.0.0",
  "description": "Plateforme marocaine de concours publics, offres d'emploi et articles de blog",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "start:prod": "NODE_ENV=production node server/index.js",
    "dev:server": "nodemon server/index.js",
    "dev:client": "cd frontend && npm run dev",
    "dev": "concurrently --kill-others-on-fail --prefix-colors \"blue,green\" --names \"API,UI\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "cd frontend && npm install && npm run build && xcopy /E /I /Y dist ..\\public",
    "build:unix": "cd frontend && npm install && npm run build && cp -r dist/* ../public/",
    "seed": "node server/seed.js",
    "test-scrape": "node server/test-scrape.js"
  },
  "keywords": [
    "concours",
    "maroc",
    "emploi",
    "blog"
  ],
  "author": "AtlasConcours",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "node-cron": "^4.2.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.0"
  }
}
