# =============================================
# AtlasConcours — Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Security ----
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=atlasconcours_secret_jwt_2026_maroc

# ---- AI Rewriting ----
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=votre_cle_api_ici

# ---- Scraper ----
# Set to true to run all scrapers immediately when the server starts (useful for testing)
RUN_SCRAPER_ON_START=false

# Optional cloud-egress workaround for ANAPEC / Emploi-Public.
# Use either a standard HTTP(S) proxy URL or ScrapingBee.
# SCRAPER_PROXY_URL=http://username:password@proxy-host:port
# SCRAPINGBEE_API_KEY=your_scrapingbee_key
# SCRAPINGBEE_COUNTRY_CODE=ma
# SCRAPINGBEE_PREMIUM_PROXY=true

# Secure local scrape bridge. Set this same secret on Vercel and on the
# Moroccan domestic-IP machine that runs: node server/push-local-scrape.js
# LOCAL_SCRAPE_PUSH_TOKEN=generate_a_long_random_secret

# ---- Database (Production only) ----
# On Render: set DATA_DIR=/data (matches the persistent disk mountPath in render.yaml)
# On Railway: leave unset (db.json will reset on restart — use MongoDB instead)
# Locally: leave unset (db.json stored in project root)
# DATA_DIR=/data
