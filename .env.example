# =============================================
# AtlasConcours — Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Security ----
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=atlasconcours_secret_jwt_2026_maroc

# ---- AI Rewriting ----
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=votre_cle_api_ici

# ---- Scraper ----
# Set to true to run all scrapers immediately when the server starts (useful for testing)
RUN_SCRAPER_ON_START=false

# ---- Database (Production only) ----
# On Render: set DATA_DIR=/data (matches the persistent disk mountPath in render.yaml)
# On Railway: leave unset (db.json will reset on restart — use MongoDB instead)
# Locally: leave unset (db.json stored in project root)
# DATA_DIR=/data
