{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron-scraper?source=anapec",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron-scraper?source=jobs",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron-scraper?source=concours",
      "schedule": "0 4 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
