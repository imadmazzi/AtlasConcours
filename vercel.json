{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-scraper",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "server/index.js": {
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/cron-scraper",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "server/index.js"
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      },
      "dest": "server/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
